# Binaire Proton Drive (téléchargé par install.sh, ~93 Mo)
proton-drive

# Environnement virtuel
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/

# Logs générés
logs/
*.log

# Outils de développement
.pytest_cache/
.ruff_cache/

# Verrou d'exécution (PID de la sauvegarde en cours)
.databackup.lock

# Historique des sauvegardes réussies (sauvegarde incrémentale, I7 — cf. cdc.md §6)
.databackup-state.json

# Configuration locale et secrets (ne jamais versionner)
.env
config.local

# Dossier temporaire de travail (archives avant transfert)
tmp/
backup

# IDE / éditeur
.vscode/
.idea/
.DS_Store
